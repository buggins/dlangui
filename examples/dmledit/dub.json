{
    "name": "dmledit",
    "description": "dlangui library example DML Editor",
    "homepage": "https://github.com/buggins/dlangui",
    "license": "Boost",
    "authors": ["Vadim Lopatin"],

    "stringImportPaths": ["views", "views/res", "views/res/i18n", "views/res/mdpi"],

    "targetPath": "bin",
    "targetName": "dmledit",
    "targetType": "executable",

    "versions": ["EmbedStandardResources"],

    "dependencies": {
        "dlangui": {"path": "../../"}
    },

    "configurations": [
        {
            "name": "default",
            "subConfigurations": {
                "dlangui": "minimal"
            }
        },
        {
            "name": "console",
            "subConfigurations": {
                "dlangui": "console"
            }
        },
        {
            "name": "sdl",
            "subConfigurations": {
                "dlangui": "sdl"
            }
        },
        {
            "name": "x11",
            "subConfigurations": {
                "dlangui": "x11"
            }
        }
    ]
}
